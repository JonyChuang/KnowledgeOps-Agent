# Copy this file to .env and replace every placeholder before starting Docker Compose.
# Never commit the real .env file or paste real keys into documentation, issues, or screenshots.

# Required by the current Compose environment. It may use the same provider key as EMBEDDING_API_KEY.
OPENAI_API_KEY=replace-with-a-provider-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat model: used for normal replies, Agent routing, and Function Calling.
CHAT_MODEL=replace-with-your-chat-model-name
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=replace-with-your-chat-api-key
CHAT_TEMPERATURE=0

# Embedding model: EMBEDDING_DIMENSIONS must match the model output configured here.
EMBEDDING_MODEL=replace-with-your-embedding-model-name
EMBEDDING_DIMENSIONS=512
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=replace-with-your-embedding-api-key

# Neo4j is started by Docker Compose. Use a strong local password rather than this placeholder.
NEO4J_PASSWORD=replace-with-a-strong-neo4j-password
GRAPH_INDEXING_ENABLED=true

# Authentication configuration. Use at least 32 random characters for AUTH_JWT_SECRET.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
